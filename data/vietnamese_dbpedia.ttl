vres:Phạm_Quỳnh_Anh_\(cầu_thủ_bóng_đá\) a dbo:Animal,
        dbo:Athlete,
        dbo:Person,
        dbo:SoccerPlayer,
        vio:Athlete,
        vio:FootballPlayer,
        vio:NationalTeamPlayer,
        vio:Person ;
    rdfs:label "Phạm Quỳnh Anh (cầu thủ bóng đá)"@vi ;
    dbo:abstract """Phạm Quỳnh Anh là một cầu thủ bóng đá người Việt Nam từng chơi ở vị trí tiền vệ cho Đội tuyển bóng đá nữ quốc gia Việt Nam.
Phạm Quỳnh Anh từng được triệu tập vào danh sách đội tuyển nữ Việt Nam tham dự Đại hội Thể thao Đông Nam Á 2003, giải đấu mà cô ghi được một bàn thắng từ cú đá phạt vào lưới Philippines."""@vi ;
    dbo:careerStation vres:Phạm_Quỳnh_Anh_\(cầu_thủ_bóng_đá\)__1 ;
    dbo:position vres:Tiền_vệ_\(bóng_đá\) ;
    dbo:wikiPageID 19965225 ;
    dbo:wikiPageLength "2205"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 74652934 ;
    dct:subject vcat:Cầu_thủ_bóng_đá_nữ_Việt_Nam,
        vcat:Cầu_thủ_đội_tuyển_bóng_đá_nữ_quốc_gia_Việt_Nam,
        vcat:Nhân_vật_còn_sống,
        vcat:Tiền_vệ_bóng_đá_nữ ;
    vio:careerStation vres:Phạm_Quỳnh_Anh_\(cầu_thủ_bóng_đá\)__1 ;
    vio:playedFor vres:Đội_tuyển_bóng_đá_nữ_quốc_gia_Việt_Nam ;
    vio:position vres:Tiền_vệ_\(bóng_đá\) ;
    vip:birthPlace vres:Việt_Nam ;
    vip:name "Phạm Quỳnh Anh"@vi ;
    vip:nationalcaps1 "2 (?)"@vi ;
    vip:nationalgoals1 1 ;
