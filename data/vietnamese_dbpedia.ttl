vio:populationYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "population as of"@en,
        "năm số liệu dân số"@vi ;
    rdfs:comment "Thời điểm của số liệu dân số (Wikidata P585), để tránh cộng dân số các năm khác nhau."@vi ;
    rdfs:domain vio:Location ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:gYear .

vio:position a owl:ObjectProperty ;
    rdfs:label "position"@en,
        "vị trí"@vi ;
    rdfs:domain vio:FootballPlayer ;
