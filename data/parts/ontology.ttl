vio:Athlete a owl:Class ;
    rdfs:label "Athlete"@en,
        "Vận động viên"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:Athlete,
        vio:Person .

vio:ClubStation a owl:Class ;
    rdfs:label "Club career station"@en,
        "Giai đoạn câu lạc bộ"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom vio:FootballClub ;
            owl:onProperty vio:team ],
        vio:CareerStation .

vio:NationalTeamPlayer a owl:Class ;
    rdfs:label "National team player"@en,
        "Cầu thủ từng khoác áo đội tuyển quốc gia"@vi ;
    rdfs:comment "Suy ra từ quá trình thi đấu: có ít nhất một NationalTeamStation (mọi lứa tuổi)."@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf vio:FootballPlayer .

vio:YouthStation a owl:Class ;
    rdfs:label "Youth career station"@en,
        "Giai đoạn đội trẻ"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom vio:FootballClub ;
            owl:onProperty vio:team ],
        vio:CareerStation .

vio:birthPlace a owl:ObjectProperty ;
    rdfs:label "birth place"@en,
        "nơi sinh"@vi ;
    rdfs:domain vio:Person ;
    rdfs:isDefinedBy vio: ;
    rdfs:range vio:Location ;
    rdfs:subPropertyOf dbo:birthPlace,
        schema1:birthPlace .

vio:isPartOf a owl:ObjectProperty ;
    rdfs:label "is part of"@en,
        "thuộc"@vi ;
    rdfs:domain vio:Location ;
    rdfs:isDefinedBy vio: ;
    rdfs:range vio:Location ;
    rdfs:subPropertyOf dbo:isPartOf .

vio:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in"@en,
        "nằm ở"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:range vio:Location ;
    rdfs:subPropertyOf dbo:location,
        schema1:location .

vio:playedFor a owl:ObjectProperty ;
    rdfs:label "played for"@en,
        "từng thi đấu cho"@vi ;
    rdfs:isDefinedBy vio: ;
    owl:propertyChainAxiom ( vio:careerStation vio:team ) .

vio:successor a owl:ObjectProperty ;
    rdfs:label "successor"@en,
        "đơn vị kế tục"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subPropertyOf dbo:successor .

wgs84:lat a owl:DatatypeProperty ;
    rdfs:label "latitude"@en,
        "vĩ độ"@vi ;
