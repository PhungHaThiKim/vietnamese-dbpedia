vres:Câu_lạc_bộ_bóng_đá_Công_an_nhân_dân_\(2018\) a dbo:Agent,
        dbo:Organisation,
        dbo:SoccerClub,
        dbo:SportsClub,
        vio:FootballClub,
        vio:Organisation ;
    rdfs:label "Cong An Nhan Dan FC (2026)"@en,
        "Câu lạc bộ bóng đá Công an nhân dân (2018)"@vi ;
    dbo:abstract """Câu lạc bộ bóng đá Công an Nhân dân  (tiếng Anh: Công an Nhân dân Football Club), là một câu lạc bộ bóng đá chuyên nghiệp có trụ sở ở tỉnh Hưng Yên, Việt Nam. Câu lạc bộ hiện đang thi đấu tại V.League 1, giải đấu cao nhất trong hệ thống giải đấu bóng đá Việt Nam. Sân nhà của đội là sân vận động thuộc Trung tâm đào tạo bóng đá trẻ PVF tại xã Nghĩa Trụ, tỉnh Hưng Yên.
Thành lập vào năm 2018 với tên Phố Hiến, đội bóng đổi tên thành PVF–CAND vào đầu năm 2023 sau khi được chuyển giao cho Bộ Công an quản lý."""@vi ;
