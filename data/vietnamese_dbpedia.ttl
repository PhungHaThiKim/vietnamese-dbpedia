    rdfs:label "Nguyễn Văn Biển"@en,
        "Nguyễn Văn Biển"@vi ;
    dbo:abstract """Nguyễn Văn Biển (sinh 27 tháng 4 năm 1985) là một huấn luyện viên và cựu cầu thủ bóng đá người Việt Nam. Hiện nay, anh đang làm trợ lý huấn luyện viên tại câu lạc bộ Thể Công – Viettel.
Thời còn thi đấu, Văn Biển chơi ở vị trí hậu vệ cho câu lạc bộ Nam Định và Hà Nội. Anh cũng có 27 lần ra sân cho đội tuyển quốc gia Việt Nam và ghi được 2 bàn thắng."""@vi ;
    dbo:birthDate "1985-04-27"^^xsd:date ;
