vres:Hải_Ninh_\(tỉnh\) a dbo:AdministrativeRegion,
        dbo:GovernmentalAdministrativeRegion,
        dbo:Place,
        dbo:PopulatedPlace,
        dbo:Province,
        dbo:Region,
        vio:FormerProvince,
        vio:Location,
        vio:Province ;
    rdfs:label "Hải Ninh (tỉnh)"@vi ;
    dbo:abstract "Hải Ninh là một tỉnh cũ thuộc vùng Đông Bắc Bộ Việt Nam, tồn tại từ ngày 10 tháng 12 năm 1906 đến ngày 30 tháng 10 năm 1963. Địa bàn tỉnh Hải Ninh hiện nay tương ứng với một phần thành phố Quảng Ninh và một phần tỉnh Lạng Sơn."@vi ;
    dbo:capital vres:Móng_Cái ;
    dbo:country vres:Việt_Nam ;
