    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:SoccerPlayer,
        vio:Athlete .

vio:EducationalInstitution a owl:Class ;
    rdfs:label "Educational institution"@en,
        "Cơ sở giáo dục"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:EducationalInstitution,
        vio:Organisation .

vio:CareerStation a owl:Class ;
    rdfs:label "Career station"@en,
        "Giai đoạn thi đấu"@vi ;
    rdfs:comment "Một giai đoạn cầu thủ thi đấu cho một đội: đội, năm bắt đầu, năm kết thúc, số trận, số bàn."@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:CareerStation .

vio:Person a owl:Class ;
    rdfs:label "Person"@en,
        "Người"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:Person .

vio:Location a owl:Class ;
    rdfs:label "Location"@en,
        "Địa điểm"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:Place .

vio:Organisation a owl:Class ;
    rdfs:label "Organisation"@en,
        "Tổ chức"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:Organisation .

vio: a owl:Ontology ;
    rdfs:label "Vietnamese DBpedia Ontology"@en,
        "Ontology Vietnamese DBpedia"@vi ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    rdfs:comment "Từ vựng cho dữ liệu bóng đá, tỉnh thành và trường đại học Việt Nam trích từ Wikipedia tiếng Việt và Wikidata; mọi lớp và thuộc tính được ánh xạ sang DBpedia Ontology."@vi ;
    owl:versionInfo "2.0" .

[] a owl:AllDisjointClasses ;
    owl:members ( vio:Province vio:Stadium vio:Country ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vio:YouthStation vio:ClubStation vio:NationalTeamStation ) .

[] rdfs:subClassOf vio:NationalTeamPlayer ;
    owl:intersectionOf ( vio:FootballPlayer [ a owl:Restriction ;
                owl:onProperty vio:careerStation ;
                owl:someValuesFrom vio:NationalTeamStation ] ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vio:FootballClub vio:EducationalInstitution vio:NationalFootballTeam ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vio:Person vio:Organisation vio:Location vio:CareerStation ) .

