vres:Nguyễn_Minh_Phương_\(cầu_thủ_bóng_đá\) a dbo:Animal,
        dbo:Athlete,
        dbo:Person,
        dbo:SoccerPlayer,
        vio:Athlete,
        vio:FootballPlayer,
        vio:NationalTeamPlayer,
        vio:Person ;
    rdfs:label "Nguyễn Minh Phương"@en,
        "Nguyễn Minh Phương (cầu thủ bóng đá)"@vi ;
    dbo:abstract """Nguyễn Minh Phương (sinh ngày 5 tháng 7 năm 1980) là huấn luyện viên và là cựu cầu thủ người Việt Nam. Hiện ông là huấn luyện viên trưởng của Câu lạc bộ bóng đá Bà Rịa - Vũng Tàu.
Ông từng là thành viên của đội tuyển bóng đá quốc gia Việt Nam giành chức vô địch AFF Suzuki Cup 2008 và cựu đội trưởng đội tuyển bóng đá quốc gia. Là chủ nhân Quả bóng vàng Việt Nam năm 2010.
Minh Phương giải nghệ vào cuối mùa bóng 2015 trong màu áo câu lạc bộ SHB Đà Nẵng.
Khởi đầu sự nghiệp ở vai trò hậu vệ cánh phải, sau đó là tiền vệ cánh phải. Nhưng tên tuổi của Minh Phương chỉ thực sự rực sáng khi được huấn luyện viên Henrique Calisto ở Đồng Tâm Long An đưa vào đá ở vị trí tiền vệ trung tâm, ông được xem như là một trong những tiền vệ vĩ đại nhất mà bóng đá Việt Nam từng sản sinh."""@vi ;
    dbo:birthDate "1980-07-05"^^xsd:date ;
    dbo:birthPlace vres:Long_Khánh_\(thành_phố\),
        vres:Đồng_Nai ;
    dbo:careerStation vres:Nguyễn_Minh_Phương_\(cầu_thủ_bóng_đá\)__1,
        vres:Nguyễn_Minh_Phương_\(cầu_thủ_bóng_đá\)__2,
