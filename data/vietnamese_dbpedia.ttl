    vip:years1 """2007-2014
2014-"""@vi ;
    rdfs:comment "Trần Khoa Điển là một thủ môn bóng đá người Việt Nam chơi cho TP.HCM của giải V-League. Khoa Điển gia nhập đội Thành phố Hồ Chí Minh năm 2006 sau khi tạo những ấn tượng. Năm 2007, anh được vào câu lạc bộ TMN CSG đưa vào thi đấu thay cho thủ môn Hoàng Công Vương. Năm 2008 anh là thủ môn chính thức của TMN.CSG. Năm 2009 anh được ông Henrique Calisto triệu tập vào danh sách tham dự SEA Games 25."@vi ;
    owl:sameAs dbr:Trần_Khoa_Điển,
        wd:Q10829342 ;
    prov:wasDerivedFrom <https://vi.wikipedia.org/wiki/Tr%E1%BA%A7n_Khoa_%C4%90i%E1%BB%83n?oldid=75375721&ns=0> ;
    foaf:isPrimaryTopicOf <https://vi.wikipedia.org/wiki/Tr%E1%BA%A7n_Khoa_%C4%90i%E1%BB%83n> .

