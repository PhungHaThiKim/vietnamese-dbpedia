        <http://vietnamnet.vn/vn/chinh-tri/157792/dia-phuong-chay-chot-the-nao-bo-truong-biet-het.html>,
        <https://web.archive.org/web/20181113000501/http://vids.mpi.gov.vn/vietnam2035/12/39.html> ;
    dbo:wikiPageID 626284 ;
    dbo:wikiPageLength "18297"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75443253 ;
