vres:Bùi_Quang_Vinh a dbo:Animal,
        dbo:Athlete,
        dbo:Person,
        dbo:SoccerPlayer,
        vio:Athlete,
        vio:FootballPlayer,
        vio:Person ;
    rdfs:label "Bùi Quang Vinh"@en,
        "Bùi Quang Vinh"@vi ;
    dbo:abstract "Bùi Quang Vinh (sinh năm 1953) là một chính khách Việt Nam. Ông nguyên là Ủy viên Ban Chấp hành Trung ương Đảng Cộng sản Việt Nam khóa X, XI, Bộ trưởng Bộ Kế hoạch và Đầu tư Việt Nam (2011-2016),Đại biểu Quốc hội Việt Nam khóa XIII tỉnh Lai Châu. Trong vai trò Bộ trưởng Kế hoạch Đầu tư, ông Bùi Quang Vinh được cho là người giám sát và tham gia soạn thảo đề án đặc khu hành chính - kinh tế Vân Đồn, Bắc Vân Phong, Phú Quốc."@vi ;
    dbo:birthDate "1953-08-08"^^xsd:date ;
