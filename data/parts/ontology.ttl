vio:NationalTeamStation a owl:Class ;
    rdfs:label "National team career station"@en,
        "Giai đoạn đội tuyển quốc gia"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom vio:NationalFootballTeam ;
            owl:onProperty vio:team ],
        vio:CareerStation .

vio:careerStation a owl:ObjectProperty ;
    rdfs:label "career station"@en,
        "giai đoạn thi đấu"@vi ;
    rdfs:domain vio:FootballPlayer ;
    rdfs:isDefinedBy vio: ;
    rdfs:range vio:CareerStation ;
    rdfs:subPropertyOf dbo:careerStation .

dbo:Organisation a owl:Class ;
    rdfs:label "organisation"@en,
        "Tổ chức"@vi ;
    rdfs:isDefinedBy dbo: ;
    rdfs:subClassOf dbo:Agent .

vio:team a owl:ObjectProperty ;
    rdfs:label "team"@en,
        "đội"@vi ;
    rdfs:comment "Đội của một giai đoạn thi đấu. Không đặt range chung; ràng buộc theo từng loại giai đoạn bên dưới."@vi ;
    rdfs:domain vio:CareerStation ;
    rdfs:isDefinedBy vio: ;
    rdfs:subPropertyOf dbo:team .

vio:FootballClub a owl:Class ;
    rdfs:label "Football club"@en,
        "Câu lạc bộ bóng đá"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:SoccerClub,
        vio:Organisation .

vio:Province a owl:Class ;
    rdfs:label "Province"@en,
        "Tỉnh, thành phố trực thuộc trung ương"@vi ;
    rdfs:comment "Đơn vị hành chính cấp tỉnh, kể cả tỉnh đã giải thể hoặc sáp nhập (xem vio:dissolutionYear)."@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:Province,
        vio:Location .

vio:Stadium a owl:Class ;
    rdfs:label "Stadium"@en,
        "Sân vận động"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:Stadium,
