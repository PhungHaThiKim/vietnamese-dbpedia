vres:Võ_Đình_Tân a dbo:Animal,
        dbo:Athlete,
        dbo:Person,
        dbo:SoccerPlayer,
        vio:Athlete,
        vio:FootballPlayer,
        vio:Person ;
    rdfs:label "Võ Đình Tân"@en,
        "Võ Đình Tân"@vi ;
    dbo:abstract "Võ Đình Tân (sinh ngày 4 tháng 10 năm 1967) là một huấn luyện viên và cựu cầu thủ bóng đá người Việt Nam. Hiện nay, ông đang dẫn dắt câu lạc bộ Khánh Hoà thi đấu tại V.League 2. Ông là người có công lớn khi đưa đội bóng Sanna Khánh Hoà lên thi đấu ở sân chơi chuyên nghiệp sau khi đội Khatoco Khánh Hòa giải thể vào cuối năm 2012."@vi ;
    dbo:birthDate "1967-10-04"^^xsd:date ;
    dbo:birthPlace vres:Khánh_Hòa ;
    dbo:careerStation vres:Võ_Đình_Tân__1 ;
    dbo:position vres:Hậu_vệ_\(bóng_đá\) ;
    dbo:wikiPageID 3346944 ;
    dbo:wikiPageLength "5628"^^xsd:nonNegativeInteger ;
