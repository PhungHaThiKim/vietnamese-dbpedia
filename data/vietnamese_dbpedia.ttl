vres:Kiến_An_\(tỉnh\) a dbo:AdministrativeRegion,
        dbo:GovernmentalAdministrativeRegion,
        dbo:Place,
        dbo:PopulatedPlace,
        dbo:Province,
        dbo:Region,
        vio:FormerProvince,
        vio:Location,
        vio:Province ;
    rdfs:label "Kiến An (tỉnh)"@vi ;
    dbo:abstract "Kiến An là một tỉnh cũ thuộc vùng Đồng bằng sông Hồng, Đông Bắc Bộ, Việt Nam. Tồn tại trong hai giai đoạn: Ngày 11 tháng 9 năm 1887 đến ngày 19 tháng 12 năm 1946; ngày 7 tháng 11 năm 1949 đến ngày 27 tháng 10 năm 1962. Nay là một phần thành phố Hải Phòng."@vi ;
    dbo:capital vres:Kiến_An_\(quận\) ;
    dbo:country vres:Việt_Nam ;
    dbo:region vres:Đông_Bắc_Bộ,
        vres:Đồng_bằng_sông_Hồng ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Province_de_Kien-An_%281909%29.jpg/330px-Province_de_Kien-An_%281909%29.jpg> ;
