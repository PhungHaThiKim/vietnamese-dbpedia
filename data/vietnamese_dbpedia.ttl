vres:Bắc_Kạn_\(tỉnh\) a dbo:AdministrativeRegion,
        dbo:GovernmentalAdministrativeRegion,
        dbo:Place,
        dbo:PopulatedPlace,
        dbo:Province,
        dbo:Region,
