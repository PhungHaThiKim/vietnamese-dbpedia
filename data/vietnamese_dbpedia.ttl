        <https://web.archive.org/web/20061003174304/http://dangcongsan.vn/details.asp?topic=9&subtopic=32&leader_topic=105&id=BT2390638529>,
        <https://web.archive.org/web/20061023012055/http://laws.dongnai.gov.vn/1991_to_2000/1994/199412/199412200001/lawdocument_view>,
        <https://web.archive.org/web/20070311022152/http://www.cpv.org.vn/details.asp?topic=4&subtopic=288&leader_topic=721&id=BT710425137> ;
