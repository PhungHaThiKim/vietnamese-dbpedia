    rdfs:label "Điện Biên province"@en,
        "Điện Biên"@vi ;
    dbo:abstract """Điện Biên là một tỉnh miền núi thuộc vùng Tây Bắc Bộ của Việt Nam.
Theo dữ liệu Sáp nhập tỉnh, thành Việt Nam 2025, Điện Biên có diện tích: 9.540 km², xếp thứ 14; dân số: 667.417 người, xếp thứ 32; GRDP 2024: 31.663.387 triệu VNĐ, xếp thứ 32; thu ngân sách 2024: 1.574.989 triệu VNĐ, xếp thứ 34; thu nhập bình quân: 28,20 triệu VNĐ/năm, xếp thứ 34."""@vi ;
    dbo:capital vres:Điện_Biên_Phủ_\(phường\),
        vres:Điện_Biên_Phủ_\(thành_phố\) ;
    dbo:country vres:Việt_Nam ;
    dbo:populationTotal "656700"^^xsd:nonNegativeInteger ;
    dbo:region vres:Trung_du_và_miền_núi_phía_Bắc,
        vres:Tây_Bắc_Bộ ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/M%C6%B0%E1%BB%9Dng_Thanh_Valley.jpg/330px-M%C6%B0%E1%BB%9Dng_Thanh_Valley.jpg> ;
