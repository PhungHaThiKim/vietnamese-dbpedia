vres:Bùi_Trần_Tuấn_Anh a dbo:Animal,
        dbo:Athlete,
        dbo:Person,
        dbo:SoccerPlayer,
        vio:Athlete,
        vio:FootballPlayer,
        vio:Person ;
    rdfs:label "Bùi Trần Tuấn Anh"@vi ;
    dbo:abstract """Bùi Trần Tuấn Anh (sinh ngày 13 tháng 3 năm 1990 tại thành phố Nha Trang, Khánh Hòa, Việt Nam) là một cầu thủ bóng đá chuyên nghiệp hiện đang thi đấu trong màu áo FLC Thanh Hóa tại V.league - 1 ở vị trí tiền đạo.
Tuấn Anh là cầu thủ bóng đá chuyên nghiệp trên sân cỏ, nhưng đồng thời cũng là cầu thủ bóng đá có nhiều thành tích trên sân cát bãi biển. Anh từng đạt danh hiệu vua phá lưới giải vô địch bóng đá bãi biển khu vực Đông Nam Á năm 2014 và từng có cơ hội thi đấu ở các câu lạc bộ bóng đá bãi biển đến từ Trung Đông."""@vi ;
    dbo:birthDate "1990-03-13"^^xsd:date ;
