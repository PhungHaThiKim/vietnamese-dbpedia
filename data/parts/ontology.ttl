dbo:Person a owl:Class ;
    rdfs:label "person"@en,
        "Người"@vi ;
    rdfs:isDefinedBy dbo: ;
    rdfs:subClassOf dbo:Animal .

dbo:Place a owl:Class ;
    rdfs:label "place"@en,
        "Địa điểm"@vi ;
    rdfs:isDefinedBy dbo: .

dbo:PopulatedPlace a owl:Class ;
    rdfs:label "populated place"@en,
