    rdfs:isDefinedBy dbo: ;
    rdfs:subClassOf dbo:SportsClub .

dbo:team a owl:ObjectProperty ;
    rdfs:label "team"@en,
        "đội"@vi ;
    rdfs:isDefinedBy dbo: .

vio:Country a owl:Class ;
    rdfs:label "Country"@en,
        "Quốc gia"@vi ;
