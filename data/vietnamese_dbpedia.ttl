vres:Hoàng_Văn_Phúc a dbo:Animal,
        dbo:Athlete,
        dbo:Person,
        dbo:SoccerPlayer,
        vio:Athlete,
        vio:FootballPlayer,
        vio:Person ;
    rdfs:label "Hoàng Văn Phúc"@en,
        "Hoàng Văn Phúc"@vi ;
    dbo:abstract "Hoàng Văn Phúc (sinh ngày 20 tháng 12 năm 1964) là một huấn luyện viên bóng đá và cựu cầu thủ bóng đá người Việt Nam. Ông từng là huấn luyện viên trưởng của đội tuyển bóng đá nam quốc gia Việt Nam và là người góp công lớn trong chức vô địch V.League 2017 của câu lạc bộ Quảng Nam. Hiện tại. ông đang là huấn luyện viên trưởng của đội tuyển bóng đá nữ quốc gia Việt Nam."@vi ;
    dbo:birthDate "1964-12-20"^^xsd:date ;
