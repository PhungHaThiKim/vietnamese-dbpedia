vres:Viện_Đại_học_Minh_Đức a dbo:Agent,
        dbo:EducationalInstitution,
        dbo:Organisation,
        dbo:University,
        vio:EducationalInstitution,
        vio:Organisation,
        vio:University ;
    rdfs:label "Viện Đại học Minh Đức"@vi ;
    dbo:abstract "Viện Đại học Minh Đức là viện đại học tư thục ở Gia Định, hoạt động từ năm 1970 đến năm 1975 dưới chính thể Việt Nam Cộng hòa. Viện đại học này do Giáo hội Công giáo điều hành. Năm 1975, dưới chính quyền mới, Viện Đại học Minh Đức bị giải thể."@vi ;
    dbo:country vres:Việt_Nam ;
    dbo:wikiPageExternalLink <http://www.canhnongminhduc.com/Pages2010/lichsu_cnmd_2M10.php>,
        <http://www.canhnongminhduc.com/Pages_2008/vdhmd_2M8.php>,
        <http://www.kinhthuong.net/lichsu.htm>,
        <http://www.ykhoaminhduc.org/home.html>,
        <https://web.archive.org/web/20090706194629/http://www.ykhoaminhduc.org/home.html> ;
    dbo:wikiPageID 415280 ;
    dbo:wikiPageLength "4509"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 71303779 ;
    dct:subject vcat:Cơ_sở_giáo_dục_của_Giáo_hội_Công_giáo_tại_Việt_Nam,
        vcat:Sơ_khai_Việt_Nam,
        vcat:Trường_đại_học_và_cao_đẳng_đã_ngừng_hoạt_động_tại_Việt_Nam,
        vcat:Viện_đại_học_của_Việt_Nam_Cộng_Hòa ;
    vio:country vres:Việt_Nam ;
    rdfs:comment "Viện Đại học Minh Đức là viện đại học tư thục ở Gia Định, hoạt động từ năm 1970 đến năm 1975 dưới chính thể Việt Nam Cộng hòa. Viện đại học này do Giáo hội Công giáo điều hành. Năm 1975, dưới chính quyền mới, Viện Đại học Minh Đức bị giải thể."@vi ;
    owl:sameAs wd:Q10832799 ;
    skos:altLabel "Đại học Minh Đức"@vi ;
    prov:wasDerivedFrom <https://vi.wikipedia.org/wiki/Vi%E1%BB%87n_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Minh_%C4%90%E1%BB%A9c?oldid=71303779&ns=0> ;
    foaf:isPrimaryTopicOf <https://vi.wikipedia.org/wiki/Vi%E1%BB%87n_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Minh_%C4%90%E1%BB%A9c> .

