        dbo:Person,
        dbo:SoccerPlayer,
        vio:Athlete,
        vio:FootballPlayer,
        vio:NationalTeamPlayer,
        vio:Person ;
    rdfs:label "Nguyễn Việt Thắng"@en,
        "Nguyễn Việt Thắng (cầu thủ bóng đá)"@vi ;
    dbo:abstract """Nguyễn Việt Thắng (sinh ngày 13 tháng 09 năm 1981), hay còn được biết đến với biệt danh Thắng "bế", là một Huấn luyện viên và là cựu cầu thủ từng chơi cho các câu lạc bộ Công an TP. HCM, Hoàng Anh Gia Lai, Đồng Tâm Long An, The Vissai Ninh Bình, Becamex Bình Dương, Thanh Hóa và Đội tuyển Quốc gia Việt Nam ở vị trí tiền đạo.
Hiện ông đang là huấn luyện viên trưởng của Câu lạc bộ bóng đá Trường Tươi Đồng Nai."""@vi ;
