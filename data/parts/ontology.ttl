    rdfs:isDefinedBy wgs84: .

dbo:Athlete a owl:Class ;
    rdfs:label "athlete"@en,
        "Vận động viên"@vi ;
    rdfs:isDefinedBy dbo: ;
    rdfs:subClassOf dbo:Person .

dbo:EducationalInstitution a owl:Class ;
