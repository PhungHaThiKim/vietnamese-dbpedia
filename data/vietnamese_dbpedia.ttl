vres:Ngân_Thị_Thanh_Hiếu a dbo:Animal,
        dbo:Athlete,
        dbo:Person,
        dbo:SoccerPlayer,
        vio:Athlete,
        vio:FootballPlayer,
        vio:Person ;
    rdfs:label "Ngân Thị Thanh Hiếu"@vi ;
    dbo:abstract """Ngân Thị Thanh Hiếu (sinh ngày 13 tháng 2 năm 2007) là một nữ cầu thủ bóng đá chuyên nghiệp người Việt Nam hiện đang thi đấu ở vị trí tiền vệ cánh hoặc tiền đạo cho câu lạc bộ Phong Phú Hà Nam và các cấp độ trẻ của Đội tuyển bóng đá nữ quốc gia Việt Nam.
Được giới chuyên môn và người hâm mộ ví von là "Thanh Nhã 2.0" hay "Tiểu công chúa" của bóng đá nữ Việt Nam nhờ tốc độ ấn tượng và ngoại hình thu hút, Thanh Hiếu là một trong những tài năng trẻ triển vọng nhất của khóa đào tạo tại Hà Nam. Cô từng giành danh hiệu Cầu thủ xuất sắc nhất tại Giải bóng đá nữ vô địch U19 quốc gia năm 2026."""@vi ;
    dbo:birthDate "2007-02-13"^^xsd:date ;
    dbo:birthPlace vres:Bá_Thước_\(huyện\),
        vres:Thanh_Hóa ;
    dbo:height 1.73e+00 ;
