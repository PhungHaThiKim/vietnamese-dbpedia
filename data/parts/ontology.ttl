@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix vio: <http://vi.dbpedia.org/ontology/> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dbo:abstract a owl:DatatypeProperty ;
    rdfs:label "has abstract"@en,
        "tóm tắt"@vi ;
    rdfs:isDefinedBy dbo: .

dbo:thumbnail a owl:ObjectProperty ;
    rdfs:label "thumbnail"@en,
        "ảnh thu nhỏ"@vi ;
    rdfs:isDefinedBy dbo: .

dbo:wikiPageExternalLink a owl:ObjectProperty ;
    rdfs:label "Link from a Wikipage to an external page"@en,
        "liên kết ngoài của trang Wikipedia"@vi ;
    rdfs:isDefinedBy dbo: .

dbo:wikiPageID a owl:DatatypeProperty ;
    rdfs:label "Wikipage page ID"@en,
        "mã trang Wikipedia"@vi ;
    rdfs:isDefinedBy dbo: .

dbo:wikiPageLength a owl:DatatypeProperty ;
    rdfs:label "page length (characters) of wiki page"@en,
        "độ dài trang Wikipedia (ký tự)"@vi ;
    rdfs:isDefinedBy dbo: .

dbo:wikiPageRedirects a owl:ObjectProperty ;
    rdfs:label "Wikipage redirect"@en,
        "đổi hướng tới trang"@vi ;
    rdfs:isDefinedBy dbo: .

dbo:wikiPageRevisionID a owl:DatatypeProperty ;
    rdfs:label "Wikipage revision ID"@en,
        "mã phiên bản trang Wikipedia"@vi ;
    rdfs:isDefinedBy dbo: .

vio:FormerProvince a owl:Class ;
    rdfs:label "Former province"@en,
        "Tỉnh cũ (đã giải thể, sáp nhập hoặc thuộc chế độ trước)"@vi ;
    rdfs:comment "Gán khi Wikidata không còn xếp đơn vị vào 'province of Vietnam' / 'centrally-governed city of Vietnam' (Q2824648, Q1381899) đang hiệu lực, hoặc có năm giải thể (P576)."@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf vio:Province .

vio:University a owl:Class ;
    rdfs:label "University"@en,
        "Trường đại học"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:subClassOf dbo:University,
        vio:EducationalInstitution .

vio:abbreviation a owl:DatatypeProperty ;
    rdfs:label "abbreviation"@en,
        "tên viết tắt"@vi ;
    rdfs:domain vio:Organisation ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dbo:abbreviation .

vio:academicStaffSize a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "academic staff size"@en,
        "số giảng viên"@vi ;
    rdfs:domain vio:EducationalInstitution ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf dbo:facultySize .

vio:administrativeCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "administrative code"@en,
        "mã hành chính"@vi ;
    rdfs:domain vio:Province ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:string .

vio:affiliation a owl:ObjectProperty ;
    rdfs:label "affiliation"@en,
        "trực thuộc / thành viên của"@vi ;
    rdfs:domain vio:Organisation ;
    rdfs:isDefinedBy vio: ;
    rdfs:subPropertyOf dbo:affiliation .

vio:appearances a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "appearances"@en,
        "số trận"@vi ;
    rdfs:domain vio:CareerStation ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf dbo:numberOfMatches .

vio:area a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "area (km²)"@en,
        "diện tích (km²)"@vi ;
    rdfs:comment "Đơn vị km²; không ánh xạ sang dbo:areaTotal vì DBpedia dùng m²."@vi ;
    rdfs:domain vio:Location ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:double .

vio:birthDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "birth date"@en,
        "ngày sinh"@vi ;
    rdfs:domain vio:Person ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dbo:birthDate,
        schema1:birthDate .

vio:birthProvince a owl:ObjectProperty ;
    rdfs:label "birth province"@en,
        "tỉnh nơi sinh"@vi ;
    rdfs:comment "Nơi sinh quy về cấp tỉnh qua chuỗi Wikidata P19/P131*."@vi ;
    rdfs:domain vio:Person ;
    rdfs:isDefinedBy vio: ;
    rdfs:range vio:Province ;
    rdfs:subPropertyOf vio:birthPlace .

vio:birthYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "birth year"@en,
        "năm sinh"@vi ;
    rdfs:comment "Dùng khi nguồn chỉ biết năm sinh."@vi ;
    rdfs:domain vio:Person ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf dbo:birthYear .

vio:capacity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "capacity"@en,
        "sức chứa"@vi ;
    rdfs:domain vio:Stadium ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf dbo:seatingCapacity .

vio:capital a owl:ObjectProperty ;
    rdfs:label "capital"@en,
        "tỉnh lỵ / thủ đô"@vi ;
    rdfs:domain vio:Location ;
    rdfs:isDefinedBy vio: ;
    rdfs:subPropertyOf dbo:capital .

vio:chairman a owl:ObjectProperty ;
    rdfs:label "chairman"@en,
        "chủ tịch"@vi ;
    rdfs:domain vio:Organisation ;
    rdfs:isDefinedBy vio: ;
    rdfs:range vio:Person ;
    rdfs:subPropertyOf dbo:chairman .

vio:country a owl:ObjectProperty ;
    rdfs:label "country"@en,
        "quốc gia"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:range vio:Country ;
    rdfs:subPropertyOf dbo:country .

vio:currentClub a owl:ObjectProperty ;
    rdfs:label "current club"@en,
        "câu lạc bộ hiện tại"@vi ;
    rdfs:domain vio:FootballPlayer ;
    rdfs:isDefinedBy vio: ;
    rdfs:range vio:FootballClub ;
    rdfs:subPropertyOf dbo:team .

vio:deathDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "death date"@en,
        "ngày mất"@vi ;
    rdfs:domain vio:Person ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dbo:deathDate,
        schema1:deathDate .

vio:dissolutionYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dissolution year"@en,
        "năm giải thể"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf dbo:dissolutionYear .

vio:endYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "end year"@en,
        "năm kết thúc"@vi ;
    rdfs:domain vio:CareerStation ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:gYear .

vio:foundingDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "founding date"@en,
        "ngày thành lập"@vi ;
    rdfs:domain vio:Organisation ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dbo:foundingDate .

vio:foundingYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "founding year"@en,
        "năm thành lập"@vi ;
    rdfs:comment "Dùng khi chỉ biết năm thành lập."@vi ;
    rdfs:domain vio:Organisation ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:gYear ;
    rdfs:subPropertyOf dbo:foundingYear .

vio:goals a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "goals"@en,
        "số bàn thắng"@vi ;
    rdfs:domain vio:CareerStation ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf dbo:numberOfGoals .

vio:ground a owl:ObjectProperty ;
    rdfs:label "ground"@en,
        "sân nhà"@vi ;
    rdfs:comment "Sân nhà hiện tại (Wikidata P115, infobox CLB). Domain là Organisation (không phải FootballClub) vì đội tuyển quốc gia cũng có sân nhà; với domain FootballClub, đội tuyển bị suy ra là CLB và vi phạm owl:AllDisjointClasses."@vi ;
    rdfs:domain vio:Organisation ;
    rdfs:isDefinedBy vio: ;
    rdfs:range vio:Stadium ;
    rdfs:subPropertyOf dbo:ground .

vio:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en,
        "gồm"@vi ;
    rdfs:isDefinedBy vio: ;
    owl:inverseOf vio:isPartOf .

vio:hasPlayer a owl:ObjectProperty ;
    rdfs:label "has player"@en,
        "có cầu thủ"@vi ;
    rdfs:isDefinedBy vio: ;
    owl:inverseOf vio:playedFor .

vio:height a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "height (m)"@en,
        "chiều cao (m)"@vi ;
    rdfs:domain vio:Person ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf dbo:height .

vio:latitude a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "latitude"@en,
        "vĩ độ"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf wgs84:lat .

vio:league a owl:ObjectProperty ;
    rdfs:label "league"@en,
        "giải đấu"@vi ;
    rdfs:domain vio:FootballClub ;
    rdfs:isDefinedBy vio: ;
    rdfs:subPropertyOf dbo:league .

vio:longitude a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "longitude"@en,
        "kinh độ"@vi ;
    rdfs:isDefinedBy vio: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf wgs84:long .

vio:manager a owl:ObjectProperty ;
    rdfs:label "manager"@en,
