    rdfs:label "Rạch Giá (tỉnh)"@vi ;
    dbo:abstract "Rạch Giá là tỉnh cũ ở miền Tây Nam Bộ thuộc khu vực Đồng bằng sông Cửu Long, Việt Nam, tiếp giáp với vịnh Thái Lan và là một trong những tỉnh có diện tích lớn nhất vùng lúc bấy giờ. Tỉnh Rạch Giá được thành lập vào ngày 1 tháng 1 năm 1900 và bị mất tên gọi đơn vị hành chính cấp tỉnh từ tháng 2 năm 1976 cho đến nay."@vi ;
    dbo:country vres:Việt_Nam ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Rach_Gia_Province.jpg/330px-Rach_Gia_Province.jpg> ;
