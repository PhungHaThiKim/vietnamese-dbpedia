vres:Đào_Văn_Nam a dbo:Animal,
        dbo:Athlete,
        dbo:Person,
        dbo:SoccerPlayer,
        vio:Athlete,
        vio:FootballPlayer,
        vio:Person ;
    rdfs:label "Đào Văn Nam"@en,
        "Đào Văn Nam"@vi ;
    dbo:abstract """Đào Văn Nam (sinh ngày 10 tháng 5 năm 1996) là một cầu thủ bóng đá người Việt Nam thi đấu ở vị trí hậu vệ cho câu lạc bộ Thể Công – Viettel. Anh được đánh giá là cầu thủ đa năng khi có thể chơi nhiều vị trí khác nhau như trung vệ, hậu vệ cánh và tiền vệ trung tâm.
Đào Văn Nam trưởng thành từ lò đào tạo trẻ Ninh Bình và có quãng thời gian thi đấu cho đội trẻ Hà Nội trước khi khoác áo Hồng Lĩnh Hà Tĩnh. Năm 2023, anh trở lại thi đấu cho câu lạc bộ Hà Nội với bản hợp đồng kéo dài 3 mùa giải. Năm 2026, anh chia tay câu lạc bộ Hà Nội để chuyển sang khoác áo cho câu lạc bộ Thể Công – Viettel."""@vi ;
    dbo:birthDate "1996-05-10"^^xsd:date ;
    dbo:birthPlace vres:Quỳnh_Côi_\(huyện\),
        vres:Thái_Bình_\(tỉnh\) ;
    dbo:careerStation vres:Đào_Văn_Nam__1,
        vres:Đào_Văn_Nam__2,
